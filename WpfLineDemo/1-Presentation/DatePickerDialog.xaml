<Window x:Class="WpfLineDemo.DatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datum uzlu"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF7F9FC"
        KeyDown="Window_KeyDown">

    <StackPanel Margin="20" MinWidth="260">
        <TextBlock Text="Vyberte datum přiřazené uzlu:"
                   FontSize="13" Foreground="#FF3A3A3A" Margin="0,0,0,10"/>

        <DatePicker x:Name="Picker" FontSize="14"
                    FirstDayOfWeek="Monday"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RemoveButton" Content="Odebrat" Padding="14,5" Margin="0,0,8,0"
                    Click="RemoveButton_Click"/>
            <Button Content="OK" Padding="18,5" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Zrušit" Padding="14,5"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
