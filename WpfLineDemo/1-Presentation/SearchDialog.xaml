<Window x:Class="WpfLineDemo.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prohledávání"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF7F9FC">

    <StackPanel Margin="20" MinWidth="320">
        <TextBlock Text="Zadejte hledaný text:"
                   FontSize="13" Foreground="#FF3A3A3A" Margin="0,0,0,8"/>

        <TextBox x:Name="Input" FontSize="14" Padding="4,3"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" Padding="18,5" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Zrušit" Padding="14,5"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
