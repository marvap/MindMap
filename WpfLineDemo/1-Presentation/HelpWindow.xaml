<Window x:Class="WpfLineDemo.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nápověda – Mind Map"
        Height="680" Width="580"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF7F9FC"
        KeyDown="HelpWindow_KeyDown">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF2C3E50"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Background" Value="#FFEDF1F7"/>
            <Setter Property="BorderBrush" Value="#FFBFC9D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF34495E"/>
        </Style>
        <Style x:Key="DescText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF3A3A3A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="12,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hlavička -->
        <Border Grid.Row="0" Background="#FF4A6FA5" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Nápověda – klávesové zkratky a ovládání"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Celá aplikace se ovládá myší v kombinaci s klávesami."
                           FontSize="12" Foreground="#FFD6E0EE" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Obsah -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
            <StackPanel>

                <TextBlock Text="Soubor" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + N"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Nový projekt"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + O"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Otevřít existující mapu (*.mmd)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + S"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Uložit"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + A"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Uložit jako…"/></Grid>

                <TextBlock Text="Vytváření a úprava uzlů" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="dvojklik na plátno"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Vytvořit nový uzel a začít psát text"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="začít psát"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Psaní na prázdném plátně (od 4 znaků) rovnou vytvoří uzel s textem v místě kurzoru"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="dvojklik na uzel"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Upravit text uzlu"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="tažení uzlu"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Přesunout uzel (nebo celý vybraný blok)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="R + dvojklik na uzel"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Smazat uzel (R jako Rubber / Remove) – zeptá se na potvrzení"/></Grid>

                <TextBlock Text="Formátování uzlů" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + +"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Zvětšit velikost písma o 1 – u vybraných uzlů, jinak u uzlu pod kurzorem; během editace mění velikost editovaného textu"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + -"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Zmenšit velikost písma o 1"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + 0"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Návrat na výchozí velikost písma (12)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + B"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Tučné písmo (přepínač – podruhé zruší)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + I"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Kurzíva (přepínač – podruhé zruší)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Shift+ B/G/R/Y"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Barva pozadí uzlu: B=modrá (výchozí), G=zelená, R=červená, Y=žlutá"/></Grid>

                <TextBlock Text="Spojnice mezi uzly" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="L + klik na 2 uzly"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Vytvořit spojnici (L jako Line / Link) – držte L a klikněte postupně na dva uzly (do 4 sekund)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="O + klik na 2 uzly"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Vytvořit orientovanou spojnici (O jako Oriented) – šipka uprostřed míří od prvního ke druhému uzlu"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="R + klik na 2 uzly"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Smazat spojnici mezi dvěma uzly (do 4 sekund) – funguje pro oba typy"/></Grid>

                <TextBlock Text="Výběr a schránka" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="tažení na plátně"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Výběr uzlů obdélníkem (tažení na prázdné ploše)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + klik na uzel"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Přidat uzel do výběru"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Esc"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Zrušit aktuální výběr"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + C"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Kopírovat vybrané uzly (i s jejich spojnicemi)"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + V"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Vložit ze schránky"/></Grid>

                <TextBlock Text="Editor textu (během psaní do uzlu)" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + Enter"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Potvrdit a uložit text uzlu"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Enter"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Nový řádek v textu uzlu"/></Grid>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="Esc"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Zrušit editaci (u nového prázdného uzlu ho zahodí)"/></Grid>

                <TextBlock Text="Nápověda" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KeyChip}"><TextBlock Style="{StaticResource KeyText}" Text="F1"/></Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DescText}" Text="Zobrazit / skrýt toto okno nápovědy"/></Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Patička -->
        <Border Grid.Row="2" Background="#FFECEFF4" BorderBrush="#FFD5DCE5" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock Text="Zavřete klávesou Esc nebo F1." VerticalAlignment="Center"
                           FontSize="12" Foreground="#FF6B7785"/>
                <Button Content="Zavřít" HorizontalAlignment="Right" Padding="18,5"
                        IsDefault="True" IsCancel="True" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
